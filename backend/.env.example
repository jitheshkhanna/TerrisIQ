# Copy to backend/.env and fill in as needed. All keys are optional for the core
# risk flow — the app runs and scores points with none of them set.
# NEVER commit a real .env (it is git-ignored).

# --- Gemini (optional): powers the AI chat and consented document field extraction.
#     Without it, those features return an honest "not configured" state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- LocationIQ (optional): fast type-ahead geocoding. Falls back to a slower
#     open geocoder when unset.
LOCATIONIQ_KEY=

# --- CORS: comma-separated origins allowed to call the API. Default below is for
#     local dev. Set your deployed frontend origin(s) in production.
CORS_ORIGINS=http://localhost:3000

# --- Optional API-key gate on /api/v1/risk and /api/v1/geocode. Leave the require
#     flag off for local dev. If you turn it on, clients send the key as the
#     `x-terris-key` request header.
TERRIS_REQUIRE_KEY=
TERRIS_API_KEY=

# --- Optional: trust a prebuilt spatial cache instead of rebuilding it on boot.
TERRARISK_TRUST_CACHE=
