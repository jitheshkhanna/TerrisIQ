  "_meta": {
    "purpose": "Lightweight, cited national hazard index for India points outside the surveyed cities. Bundled because the official portals (CPCB, CGWB, AAI) offer no fast keyless point API suitable for a <4s serverless call. Only verifiable public facts are stored: CEPI clusters by classification band (NOT invented numeric scores), airport locations, and CGWB groundwater status at the regional/state level. Everything is labelled with its provenance and treated as MODERATE tier, below a surveyed DEEP city.",
    "sources": {
      "cepi": "CPCB Comprehensive Environmental Pollution Index (CEPI) programme — critically (CEPI>=70) / severely (60-70) polluted industrial clusters. Classification band and cluster location only.",
      "airports": "AAI / OurAirports (public domain) aerodrome locations; AAI NOCAS obstacle funnel approximated as a radius around the aerodrome reference point.",
      "cgwb": "CGWB 'Dynamic Ground Water Resources of India' — regional/state assessment category. NOT block/taluk level; used as a regional finding, like the Chennai engine's FIRKA_REGIONAL_DEFAULT."
    }
  },

