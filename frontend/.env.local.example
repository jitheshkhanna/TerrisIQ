# Copy to frontend/.env.local if you need to point the frontend at a non-default API.
# For local dev you usually don't need this: the Next.js dev server proxies /api/* to
# the backend on :8000, so leave it unset.

# Origin of the backend API (used for server-side proxying in production).
# Example: https://your-api.vercel.app
API_ORIGIN=
